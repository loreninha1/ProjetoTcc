@page
@model ProjetoTcc.Pages.AjudaModel
@{
    ViewData["Title"] = "Suporte Imediato";
}

<div class="container my-4">
    <div class="text-center mb-5">
        <h2 class="text-danger fw-bold">🎀 Suporte Imediato & Redes de Apoio</h2>
        <p class="text-muted lead">Você não precisa passar por isso sozinha. Encontre ajuda psicológica, orientação médica e apoio institucional.</p>
    </div>

    <!-- Seção de Emergência / Orientação em Saúde -->
    <div class="row mb-4">
        <div class="col-md-6 mb-3">
            <div class="card border-danger shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title text-danger fw-bold">📞 Disque Saúde - SUS (136)</h5>
                    <p class="card-text text-secondary">
                        Canal oficial do Ministério da Saúde para obter informações sobre exames, consultas, tratamentos pelo SUS e localização de centros especializados.
                    </p>
                    <span class="badge bg-danger">Ligação Gratuita</span>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-3">
            <div class="card border-primary shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title text-primary fw-bold">🌸 CVV - Centro de Valorização da Vida (188)</h5>
                    <p class="card-text text-secondary">
                        Apoio emocional gratuito e confidencial para momentos de ansiedade, medo ou sobrecarga emocional. Atendimento 24 horas por telefone, chat ou e-mail.
                    </p>
                    <a href="https://www.cvv.org.br" target="_blank" class="btn btn-outline-primary btn-sm fw-bold">
                        Acessar Chat do CVV 🔗
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Seção de ONGs e Projetos Social de Apoio ao Câncer de Mama -->
    <h4 class="text-dark fw-bold mb-3 mt-5">🩷 ONGs e Instituições de Apoio</h4>
    <div class="row">
        <div class="col-md-6 mb-3">
            <div class="card border-0 bg-light shadow-sm">
                <div class="card-body">
                    <h5 class="fw-bold text-primary">FEMAMA</h5>
                    <p class="card-text text-secondary small">
                        Federação Brasileira de Instituições Filantrópicas de Apoio à Saúde da Mama. Luta por direitos, diagnóstico precoce e acesso a tratamentos.
                    </p>
                    <a href="https://www.femama.org.br" target="_blank" class="text-primary fw-bold text-decoration-none">
                        Visitar site oficial 🔗
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-3">
            <div class="card border-0 bg-light shadow-sm">
                <div class="card-body">
                    <h5 class="fw-bold text-primary">Instituto Oncoguia</h5>
                    <p class="card-text text-secondary small">
                        Oferece orientação gratuita para pacientes com câncer sobre direitos, tratamentos e apoio psicológico via Ligue Câncer (0800 773 1666).
                    </p>
                    <a href="http://www.oncoguia.org.br" target="_blank" class="text-primary fw-bold text-decoration-none">
                        Visitar site oficial 🔗
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
