@page
@model IndexModel
@{
    ViewData["Title"] = "M.A.E - Início";
}

<div class="text-center">
    <h1 class="display-4">Seja bem-vinda ao M.A.E.</h1>
    <p class="lead">Mulheres em Apoio e Empatia : Sua rede de acolhimento e força.</p>
    <hr/>
</div>

<div class="row mt-4">
    <div class="col-md-6 mb-3">
        <div class="card p-3 shadow-sm">
            <h3>Cadastro de Usuárias</h3>
            <p>Faça o cadastro no sistema para acessar a rede de apoio.</p>
            <a href="/Usuarias" class="btn btn-primary">Acessar Cadastro</a>
        </div>
    </div>

    <div class="col-md-6 mb-3">
        <div class="card p-3 shadow-sm">
            <h3>Histórias de Força</h3>
            <p>Compartilhe ou leia relatos e depoimentos de superação.</p>
            <a href="/Depoimentos" class="btn btn-success">Acessar Depoimentos</a>
        </div>
    </div>
</div>